# ==========================================
# Конфигурация моста MAX Messenger -> Telegram
# ==========================================

# 1. Токен бота MAX (получается в dev.max.ru / business.max.ru)
MAX_BOT_TOKEN=your_max_bot_token_here

# 2. ID группы в MAX (опционально).
# Если оставить пустым, бот в консоли выведет Chat ID при первом сообщении в группе.
MAX_CHAT_ID=

# 3. Токен Telegram бота (получается у @BotFather в Telegram)
TG_BOT_TOKEN=your_telegram_bot_token_here

# 4. ID группы в Telegram (начинается с минуса, например: -1001234567890)
# Добавьте бота в группу TG и перешлите сообщение в @getmyid_bot или проверьте /getUpdates
TG_CHAT_ID=-100xxxxxxxxxx

# Дополнительные настройки:
# Базовый URL API MAX
MAX_API_BASE=https://platform-api2.max.ru

# Отключить проверку SSL-сертификата Минцифры (True / False)
# По умолчанию True, чтобы не требовать ручной установки сертификатов Минцифры в систему.
MAX_VERIFY_SSL=False

# Префикс/название группы для сообщений в Telegram (например: "Группа MAX")
SOURCE_CHAT_NAME=MAX

# Автоматическое закрепление пересылаемых сообщений в Telegram (True / False)
TG_PIN_MESSAGES=True

# Закреплять без звукового уведомления участникам (True / False)
TG_PIN_SILENT=True
